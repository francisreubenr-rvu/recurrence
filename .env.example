# ---- Recurrence app ----------------------------------------------------------
# Hindsight Cloud:  HINDSIGHT_API_URL=https://api.hindsight.vectorize.io  (+ HINDSIGHT_API_KEY)
# Self-host:        HINDSIGHT_API_URL=http://localhost:8888                 (key usually empty)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recurrence-tamarind-sre

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# 1 = FakeMemory + template answers (no keys, no network). Plumbing only.
RECURRENCE_OFFLINE=0

# ---- Self-hosted Hindsight server (read by docker-compose.yml) ---------------
# Hindsight's own LLM, used for fact extraction and reflect. Groq works here too.
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=        # usually the same Groq key as above
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
